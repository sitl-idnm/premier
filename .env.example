# Copy to .env.local and fill in. Public vars live in .env (committed).

# --- Lead delivery: Telegram (POST /api/lead) ---
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_CHAT_ID=-1001234567890

# --- Lead delivery: Email via SMTP (POST /api/lead) ---
# SMTP mailbox that sends the notifications (e.g. Timeweb: smtp.timeweb.ru).
SMTP_HOST=smtp.timeweb.ru
SMTP_PORT=465
# true for port 465 (SSL); false for 587 (STARTTLS). Optional — inferred from port.
SMTP_SECURE=true
SMTP_USER=send@example.com
SMTP_PASS=your_mailbox_password
# From address (defaults to SMTP_USER). Comma-separated recipients in LEAD_EMAIL_TO.
LEAD_EMAIL_FROM=Премьер <send@example.com>
LEAD_EMAIL_TO=manager1@example.com,manager2@example.com

# --- Yandex SmartCaptcha (protects the lead forms) ---
# Client key (ysc1_...) — public, embedded in the widget.
NEXT_PUBLIC_SMARTCAPTCHA_SITE_KEY=ysc1_your_client_key
# Server key (ysc2_...) — secret, used for server-side validation.
SMARTCAPTCHA_SERVER_KEY=ysc2_your_server_key

# --- VK Ads leads -> Google Sheets ---
# OAuth access token for the VK Ads (ads.vk.ru) cabinet. Obtained manually (10-min window).
VK_ADS_ACCESS_TOKEN=
# Shared secret guarding POST /api/vk/webhook (passed as ?secret= or X-Webhook-Secret header).
VK_WEBHOOK_SECRET=
# Google Apps Script Web App that appends rows to the spreadsheet (no GCP / no billing).
# Deploy the script (see docs), paste its /exec URL and the secret you set inside it.
SHEETS_WEBAPP_URL=https://script.google.com/macros/s/XXXX/exec
SHEETS_WEBAPP_SECRET=
# Protects the Vercel cron endpoint GET /api/vk/sync (Vercel sends it as a Bearer token).
CRON_SECRET=

# --- Yandex.Metrika counter id (public — mirrored in committed .env) ---
NEXT_PUBLIC_YM_ID=

# --- Supabase (site-content CMS for the /admin panel) ---
# Table: premier_site_content (single row id=1, jsonb `data`). RLS: public SELECT.
SUPABASE_URL=https://your-project.supabase.co
# anon key — read path (RLS allows public SELECT of site copy)
SUPABASE_ANON_KEY=eyJ...anon
# service-role key — write path (saving edits). Dashboard → Settings → API. Server-only!
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role

# --- Admin panel (/admin) ---
ADMIN_PASSWORD=change-me
# random 32+ byte hex (openssl rand -hex 32)
ADMIN_SESSION_SECRET=change-me-to-a-long-random-secret

# --- Yandex.Metrika Stat API (admin charts) ---
# OAuth token with read access to the counter (oauth.yandex.ru). Optional — graphs off without it.
YANDEX_METRIKA_OAUTH_TOKEN=
YANDEX_METRIKA_COUNTER_ID=

# --- ИИ-поиск по прайсу (Gonka / DeepSeek) ---
# Ключ Gonka (OpenAI-совместимый). Без него локальный поиск работает, ИИ — выключен.
GONKA_API_KEY=
GONKA_URL=https://hskyauefqcgbvgvxkluj.supabase.co/functions/v1/gonka/chat/completions
GONKA_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731

# --- YClients (живой прайс + мастера, онлайн-запись) ---
# Партнёрский Bearer-токен из кабинета YClients + company_id обоих филиалов.
# Без них сайт показывает статический прайс и прячет блок «Мастера».
YCLIENTS_PARTNER_TOKEN=
YCLIENTS_COMPANY_TAGANSKAYA=
YCLIENTS_COMPANY_NOVOSLOBODSKAYA=
# Опционально — user-токен для приватных CRM-эндпоинтов (для витрины не нужен).
YCLIENTS_USER_TOKEN=
